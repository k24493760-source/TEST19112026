# Окружение. Пароли не коммитить.
# Docker Compose подставляет эти имена в контейнер db и в DATABASE_URL (хост db, порт 5432).
POSTGRES_USER=most
POSTGRES_PASSWORD=most
POSTGRES_DB=most_db
# Приложение само переписывает postgresql:// в postgresql+psycopg://. asyncpg не используется.
# Снаружи Docker база видна на localhost:5433. Внутри сети контейнеров — db:5432.
DATABASE_URL=postgresql://most:most@db:5432/most_db
# Миграции: явный URL, не подставляется из DATABASE_URL.
# На most_db нужен ALLOW_ALEMBIC_MOST_DB=1. Локально без Docker: localhost:5433/most_db_test.
ALEMBIC_DATABASE_URL=postgresql://most:most@db:5432/most_db
# ALLOW_ALEMBIC_MOST_DB=1
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
MOST_EMBEDDING_OFFLINE=1
# MOST_ALLOW_HF_DOWNLOAD=1
LLM_API_KEY=
LLM_MODEL=
# Golden Q&A LLM: по умолчанию выключено. URL только из env/yaml, не из UI.
MOST_QA_LLM_ENABLED=0
MOST_QA_LLM_ADAPTER=stub
MOST_QA_LLM_URL=
MOST_QA_LLM_MODEL=
MOST_QA_LLM_REVISION=
MOST_QA_LLM_TIMEOUT=30
MOST_QA_LLM_MAX_TOKENS=1024
MOST_QA_ENQUEUE_AFTER_CHUNK=1
SECRET_KEY=change-me
MOST_SCHEMA_BOOTSTRAP=0
# MOST_ADMIN_LOGIN=admin
# MOST_ADMIN_PASSWORD=